# Copy this file to .env and fill in real values before running
# `docker compose up`. Never commit the real .env file (it is already
# excluded via .gitignore).

# ---- Application ----
APP_NAME=employee-management-api
APP_ENV=production
LOG_LEVEL=INFO

# Comma-separated list of origins allowed to call the API via CORS.
# Include your VM's public IP / domain once deployed, e.g.:
# CORS_ORIGINS=http://localhost,http://<VM_PUBLIC_IP>
CORS_ORIGINS=http://localhost

# ---- Database ----
# These values are used both by the backend (to build its DB connection
# string) and by the postgres container itself (POSTGRES_DB/USER/PASSWORD),
# so they only need to be defined once here.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=employee_management
DATABASE_USER=empadmin
DATABASE_PASSWORD=change_me_to_a_strong_password
